# API key used to authenticate the Liferay bridge -> service channel.
# In production this MUST be a strong random value, shared with Liferay
# System Settings (Winnex Tracer-GOV Service -> apiKey).
# Example only -- never ship a real key.
WINNEX_TRACER_API_KEY=change-me-in-production

# Internal-mode credential (required for mode="internal"; fail-closed).
WINNEX_TRACER_INTERNAL_CREDENTIAL=

# WORM evidence path (append-only audit chain)
TRACER_GOV_WORM_PATH=/var/lib/tracer-gov/worm

# Service port
TRACER_GOV_PORT=8601
